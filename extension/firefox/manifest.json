{
  "manifest_version": 3,
  "name": "Rosint Hidden History",
  "short_name": "Rosint",
  "version": "1.4.0",
  "description": "See what Reddit hides: hidden profile histories from public archives, and no sign-in nags or NSFW gates while signed out.",
  "homepage_url": "https://github.com/yoshik08/ROSINT-Extension",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Rosint Hidden History",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rosint-hidden-history@rosint.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": [
    "*://www.reddit.com/*",
    "https://arctic-shift.photon-reddit.com/*",
    "https://api.pullpush.io/*",
    "https://removal.rosint.dev/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.reddit.com/*"
      ],
      "js": [
        "quiet.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
