{
  "name": "rosint-extension",
  "version": "1.3.0",
  "private": true,
  "description": "Browser extension that restores the posts and comments of Reddit profiles that hide their history, from public archives.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshik08/ROSINT-Extension.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node extension/scripts/build.mjs",
    "test": "npm run test:core && npm run ext:test",
    "test:core": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && web-ext lint --source-dir extension/firefox",
    "ext:build": "node extension/scripts/build.mjs",
    "ext:test": "vitest run --config extension/vitest.config.js",
    "ext:test:e2e": "vitest run --config extension/vitest.config.e2e.js",
    "ext:lint": "eslint extension src && web-ext lint --source-dir extension/firefox",
    "ext:check": "npm run check",
    "ext:live:firefox": "node extension/scripts/live-firefox.mjs",
    "ext:live:spa": "node extension/scripts/live-firefox-spa.mjs",
    "ext:live:public": "node extension/scripts/live-firefox-public.mjs",
    "ext:live:chrome": "node extension/scripts/diagnose.mjs",
    "ext:live:timing": "node extension/scripts/live-timing.mjs",
    "ext:outage": "node extension/scripts/outage-chrome.mjs",
    "ext:popup:shots": "node extension/scripts/popup-shots.mjs",
    "ext:store:shots": "node extension/scripts/store-shots.mjs",
    "ext:icons": "node extension/scripts/icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "10.15.0",
    "globals": "17.4.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.0",
    "selenium-webdriver": "4.52.0",
    "vitest": "5.1.0",
    "web-ext": "10.8.0"
  }
}
